{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "NODE_ENV"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "^generate"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "^generate"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^generate"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}

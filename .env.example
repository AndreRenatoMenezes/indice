# Banco local (docker-compose) — em produção use a string do Cloud SQL
DATABASE_URL="postgresql://indice:indice@localhost:5432/indice?schema=public"

# API
API_PORT=8080
API_HOST=0.0.0.0
# Chave estática para o único usuário (dev). Em produção, gere via `npm run db:seed` e guarde no Secret Manager.
INDICE_API_KEY="dev-local-key"
INDICE_USER_EMAIL="arsbdm@gmail.com"
CORS_ORIGIN="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:8080"
INDICE_API_KEY_WEB="dev-local-key"
